# ===== Python =====
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# ===== 虚拟环境 =====
.venv/
venv/
env/

# ===== 敏感配置（绝不入库）=====
.env

# ===== IDE =====
.idea/

# ===== 项目数据（原始文档 / 中间产物 / 评测集，体积大且可能含个人信息）=====
data/raw/*
data/processed/*
data/eval/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/eval/.gitkeep
小旦答：复旦校园智能问答与心理健康监测系统.md

# ===== 模型权重（目录结构保留，权重文件不入库）=====
models/*
!models/.gitkeep
*.pt
*.bin
*.safetensors

# ===== 本地工程笔记（不入库）=====
# docs/ 是开发过程的工作记录：含逐项实测数据、未完成事项与已知缺陷的自查清单。
# 它随迭代频繁变动，且不少结论是"阶段性待复测"的中间态，
# 不适合作为对外材料随仓库发布——故整目录保留在本地。
docs/

# ===== 日志与运行产物 =====
logs/
*.log
rag_eval_report.csv
# Trainer 训练中间产物（最优权重另存 models/）
# 注意：注释必须独占一行——git 不支持行内注释，写成 `outputs/  # 说明`
# 会被当成字面模式匹配，规则实际不生效（v2 实测发现，原写法确实没生效）
outputs/
.pytest_cache/
# HuggingFace 模型下载缓存（Docker 挂载目录）
hf_cache/
.vscode/

# ===== 中间件本地存储 =====
volumes/

# ===== 操作系统 =====
.DS_Store
Thumbs.db
