# ============================================================
# 环境变量模板：复制为 .env 后填入真实值（.env 已被 gitignore 屏蔽）
# 敏感信息绝不入库；仓库内代码全部通过本文件读取配置
# 可调参数均带默认值，按需覆盖；删除某行即回落到代码默认值
# ============================================================

# ----- DeepSeek API（回答生成 / 关怀回复；两端点互为降级备份）-----
DEEPSEEK_API_KEY=sk-xxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT=30

# ----- 轻量任务模型（意图路由 / 质量评估 / Query 改写 / 摘要 / FAQ 校验）-----
# 接入方式二选一：
#   1. 本地 vLLM 启动：vllm serve Qwen/Qwen2.5-14B-Instruct-AWQ --port 8000
#   2. 云端 OpenAI 兼容端点（如 SiliconFlow 的 Qwen 托管服务）
# 端点不可用时轻量任务自动降级到 DeepSeek，流程不中断
LOCAL_LLM_BASE_URL=http://localhost:8000/v1
LOCAL_LLM_API_KEY=dummy
LOCAL_LLM_MODEL=Qwen/Qwen2.5-14B-Instruct-AWQ
LOCAL_LLM_TIMEOUT=15

# ----- PostgreSQL（Checkpointer 短期记忆 / 长期记忆 / 高危上报，独立表）-----
# docker compose 启动时容器内自动覆盖为服务名 postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=xiaodan
POSTGRES_PASSWORD=changeme
POSTGRES_DB=xiaodan

# ----- Milvus（向量数据库）-----
MILVUS_URI=http://localhost:19530
MILVUS_COLLECTION=xiaodan_kb
MILVUS_FAQ_COLLECTION=xiaodan_faq

# ----- 嵌入 / 重排模型（首次运行自动从 HuggingFace 下载）-----
EMBED_MODEL_NAME=BAAI/bge-m3
RERANK_MODEL_NAME=BAAI/bge-reranker-v2-m3
# 国内网络建议切换镜像源加速下载；海外网络可改回 https://huggingface.co
HF_ENDPOINT=https://hf-mirror.com

# ----- 检索与匹配参数（可调，附默认值）-----
# 混合检索两路各召回的候选数
HYBRID_TOP_K=20
# 重排后送入生成的最终片段数
RERANK_TOP_K=5
# FAQ 专用索引的高置信度命中阈值（超过才进入轻量校验）
FAQ_MATCH_THRESHOLD=0.85

# ----- 情绪检测（模型路径由训练脚本产出）-----
EMOTION_MODEL_PATH=models/emotion-xlmr
# 规则判中度 + 模型高危概率超过该值时融合升级为高危
HIGH_RISK_PROB_THRESHOLD=0.5
# 连续 N 轮负面弱信号触发风险等级升一级
ESCALATION_ROUNDS=3

# ----- 轻度 / 中度关怀渠道信息（care_suffix 节点注入，脱敏占位）-----
# 中度困扰回复末尾附加的求助渠道；真实联系方式请部署方自行填入
CARE_CENTER_INFO_ZH=如需支持，可联系学校心理咨询中心（联系方式请向辅导员或校官网查询）。
CARE_CENTER_INFO_EN=If you need support, please contact the university counseling center (contact details available from your counselor or the official website).

# ----- 高危上报邮箱（可选：false 时仅写库留痕）-----
ALERT_EMAIL_ENABLED=false
ALERT_SMTP_HOST=
ALERT_SMTP_PORT=465
ALERT_SENDER=
ALERT_RECEIVER=
ALERT_SMTP_PASSWORD=

# ----- Agent 流程控制（可调，附默认值）-----
# 质量评估不合格最多重试次数（达到后无论质量如何放行）
MAX_RETRY=2
# LangGraph 递归上限（兜底防死循环）
RECURSION_LIMIT=25
# 生成时携带的最大对话历史轮数
HISTORY_MAX_ROUNDS=10

# ----- 评测（模块四：RAGAS 裁判模型，GPT-4o 快照版跨模型族去偏）-----
OPENAI_API_KEY=sk-xxxxxxxx
JUDGE_MODEL=gpt-4o-2024-08-06

# ----- Langfuse 全链路追踪（可选：两个 key 都非空才启用）-----
# docker compose --profile observability up -d 启动面板后，
# 在 http://localhost:3000 创建项目获取 keys
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000
