# ============================================================
# 环境变量模板：复制为 .env 后填入真实值（.env 已被 gitignore 屏蔽）
# 敏感信息绝不入库；仓库内代码全部通过 config/settings.py 读取配置
#
# 本模板只放**不常变**的配置：密钥、连接地址、模型路径、开关、检索参数。
# 刻意不写死具体型号——模型更迭很快（旧型号会被下线，例：deepseek-chat 已从官方
# 模型列表移除），写死在模板里迟早过期。型号一律注释掉，留空即用
# config/settings.py 的默认值；需要固定版本时再填当前可用型号（以厂商文档为准）。
# 同理，"因所用平台而异"的端点只给注释示例，不写死实际值。
# 可调参数均带默认值，按需覆盖；删除某行即回落到代码默认值。
# ============================================================

# ----- DeepSeek API（回答生成 / 关怀回复；两端点互为降级备份）-----
# 密钥必填（也可只配系统环境变量 DEEPSEEK，本项留空即可）
DEEPSEEK_API_KEY=sk-xxxxxxxx
# 官方唯一的 OpenAI 兼容端点，多年未变，故写实
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 型号留空 = 用代码默认值；固定版本时才填（示例：deepseek-flash / deepseek-v4-pro）
# DEEPSEEK_MODEL=
DEEPSEEK_TIMEOUT=30
# 思考模式开关：false = 模型直接作答（本项目的默认选择）
# 开启后思考 token 按输出价计费，且厂商会改写 temperature，确定性下降
DEEPSEEK_THINKING=false

# ----- 轻量任务模型（意图路由 / 质量评估 / Query 改写 / 摘要 / FAQ 校验）-----
# 密钥必填（也可只配系统环境变量 QWEN，本项留空即可）
LIGHT_LLM_API_KEY=sk-xxxxxxxx
# 端点与型号**必须成对匹配同一个服务**，且端点因平台而异（百炼 / 千问AI平台 /
# 区域化 WorkspaceId 端点各有不同 URL），故不写死：
#   云端示例：https://dashscope.aliyuncs.com/compatible-mode/v1
#   本地示例：http://localhost:8000/v1（vLLM 部署）
# 留空 = 用代码默认值（本地 vLLM 端点）；端点不可用时自动降级 DeepSeek，流程不中断
# LIGHT_LLM_BASE_URL=
# LIGHT_LLM_MODEL=
LIGHT_LLM_TIMEOUT=15
# 思考模式开关：轻量任务**必须关闭**
# 本组任务按 temperature=0.1 求确定性判定，而思考模式会把温度强制改写为 0.6
LIGHT_LLM_THINKING=false

# ----- 本地兜底模型（可选：仅当云端端点全部不可用时接管轻量任务）-----
# 作用：主用端点与降级端点都在云端时，断网即全挂；本组变量提供离线底线。
# 默认关闭；选定模型后填 FALLBACK_LLM_MODEL 并把 ENABLED 改为 true
# （ENABLED 与 MODEL 两者齐备才生效）。
# base_url 默认指向 Ollama 的 OpenAI 兼容端点；用 vLLM 则改为 http://localhost:8000/v1
# 注意与 LIGHT_LLM 不要撞端口。超时默认给得较宽：本地模型冷启动载入权重很慢。
FALLBACK_LLM_ENABLED=false
FALLBACK_LLM_BASE_URL=http://localhost:11434/v1
FALLBACK_LLM_API_KEY=ollama
FALLBACK_LLM_MODEL=
FALLBACK_LLM_TIMEOUT=180

# ----- PostgreSQL（Checkpointer 短期记忆 / 长期记忆 / 高危上报，独立表）-----
# docker compose 启动时容器内自动覆盖为服务名 postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=xiaodan
POSTGRES_PASSWORD=changeme
POSTGRES_DB=xiaodan

# ----- Milvus（向量数据库）-----
MILVUS_URI=http://localhost:19530
MILVUS_COLLECTION=xiaodan_kb
MILVUS_FAQ_COLLECTION=xiaodan_faq

# ----- 嵌入 / 重排模型 -----
# 填 HuggingFace 模型 id（首次运行自动下载）或本地权重目录
EMBED_MODEL_NAME=BAAI/bge-m3
RERANK_MODEL_NAME=BAAI/bge-reranker-v2-m3
# 国内网络建议切换镜像源加速下载；海外网络可改回 https://huggingface.co
HF_ENDPOINT=https://hf-mirror.com

# ----- 检索与匹配参数（可调，附默认值）-----
# 混合检索两路各召回的候选数
HYBRID_TOP_K=20
# 重排后送入生成的最终片段数
RERANK_TOP_K=5
# FAQ 专用索引的高置信度命中阈值（超过才进入轻量校验）
FAQ_MATCH_THRESHOLD=0.85

# ----- 情绪检测（模型路径由训练脚本产出）-----
EMOTION_MODEL_PATH=models/emotion-xlmr
# 模型结论被采纳的概率门槛：规则判中度 + 模型高危概率超过该值时融合升级为高危；
# 模型最高概率不超过该值时其结论一律不采信（以规则引擎为准）
HIGH_RISK_PROB_THRESHOLD=0.5
# 连续 N 轮负面弱信号触发风险等级升一级
ESCALATION_ROUNDS=3
# 语义判别层开关：规则快路径之后的 LLM 事实抽取（补隐晦表达的漏报），默认开启。
# 关闭后只剩规则 + 分类模型，隐晦高危会整片漏掉；故障时它会自动维持前两层结论。
EMOTION_SEMANTIC_ENABLED=true
# 边界带（中度困扰）追加采样次数：单次判级在「中度 ↔ 高危」之间会抖动，
# 追加采样取最高等级（宁严勿漏）。0 = 只判一次、最省延迟
EMOTION_SEMANTIC_ESCALATION=2

# ----- 轻度 / 中度关怀渠道信息（care_suffix 节点注入，脱敏占位）-----
# 中度困扰回复末尾附加的求助渠道；真实联系方式请部署方自行填入
CARE_CENTER_INFO_ZH=如需支持，可联系学校心理咨询中心（联系方式请向辅导员或校官网查询）。
CARE_CENTER_INFO_EN='If you need support, please contact the university counseling center (contact details available from your counselor or the official website).'

# ----- 高危上报邮箱（可选：false 时仅写库留痕）-----
ALERT_EMAIL_ENABLED=false
ALERT_SMTP_HOST=
ALERT_SMTP_PORT=465
ALERT_SENDER=
ALERT_RECEIVER=
ALERT_SMTP_PASSWORD=

# ----- Agent 流程控制（可调，附默认值）-----
# 质量评估不合格最多重试次数（达到后无论质量如何放行）
MAX_RETRY=2
# LangGraph 递归上限（兜底防死循环）
RECURSION_LIMIT=25
# 生成时携带的最大对话历史轮数
HISTORY_MAX_ROUNDS=10

# ----- 评测（模块四：RAGAS 裁判模型）-----
# 裁判与生成模型跨族去偏；密钥必填（也可只配系统环境变量 QWEN）
JUDGE_API_KEY=sk-xxxxxxxx
# 裁判型号**必须带日期后缀的快照版**：模型静默升级会让不同迭代的评测分数不可比，
# 而纵向可复现性正是离线评测存在的意义。故不写死，取当前可用的日期快照填写。
# JUDGE_MODEL=
# 百炼兼容端点示例（若改用其他平台请替换）
# JUDGE_BASE_URL=

# ----- Langfuse 全链路追踪（可选：两个 key 都非空才启用）-----
# docker compose --profile observability up -d 启动面板后，
# 在 http://localhost:3000 创建项目获取 keys
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000